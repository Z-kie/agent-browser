# agent-browser Environment Variables
# Copy this file to .env and fill in the values for your environment.

# ── Cloud Browser Providers ────────────────────────────────────────────────────

# Browserbase: remote browser infrastructure (https://browserbase.com)
# Required when using --provider=browserbase
BROWSERBASE_API_KEY=your-browserbase-api-key
BROWSERBASE_PROJECT_ID=your-browserbase-project-id

# Browser Use: cloud browser infrastructure for AI agents (https://browser-use.com)
# Required when using --provider=browseruse
BROWSER_USE_API_KEY=your-browser-use-api-key

# Kernel: cloud browser infrastructure with stealth mode (https://www.kernel.sh)
# Required when using --provider=kernel
KERNEL_API_KEY=your-kernel-api-key
KERNEL_HEADLESS=true
KERNEL_STEALTH=false
KERNEL_PROFILE_NAME=
KERNEL_TIMEOUT_SECONDS=30

# ── Session & Daemon Configuration ────────────────────────────────────────────

# Named session identifier (alternative to --session flag)
AGENT_BROWSER_SESSION=

# Session name for profile persistence (alternative to --session-name flag)
AGENT_BROWSER_SESSION_NAME=

# Socket directory for daemon IPC (default: system temp dir)
AGENT_BROWSER_SOCKET_DIR=

# Run browser in headed mode (shows the browser window)
# AGENT_BROWSER_HEADED=false

# Enable debug output
# AGENT_BROWSER_DEBUG=false

# ── Browser Settings ───────────────────────────────────────────────────────────

# Path to browser executable (uses system Playwright browser if unset)
# AGENT_BROWSER_EXECUTABLE_PATH=

# Browser provider: local | browserbase | browseruse | kernel
# AGENT_BROWSER_PROVIDER=local

# Proxy server URL (e.g., http://proxy.example.com:8080)
# AGENT_BROWSER_PROXY=

# Hosts to bypass proxy (comma-separated)
# AGENT_BROWSER_PROXY_BYPASS=

# Custom user agent string
# AGENT_BROWSER_USER_AGENT=

# Color scheme: light | dark | no-preference
# AGENT_BROWSER_COLOR_SCHEME=no-preference

# Ignore HTTPS certificate errors (useful for self-signed certs in dev)
# AGENT_BROWSER_IGNORE_HTTPS_ERRORS=false

# Allow file:// URL access
# AGENT_BROWSER_ALLOW_FILE_ACCESS=false

# Comma-separated list of extra browser arguments
# AGENT_BROWSER_ARGS=

# Comma-separated list of browser extension paths to load
# AGENT_BROWSER_EXTENSIONS=

# Default navigation/action timeout in milliseconds
# AGENT_BROWSER_DEFAULT_TIMEOUT=30000

# ── Security & Action Policy ──────────────────────────────────────────────────

# Encryption key for encrypted session state (32-byte hex string)
# AGENT_BROWSER_ENCRYPTION_KEY=

# Comma-separated list of allowed domains (empty = all allowed)
# AGENT_BROWSER_ALLOWED_DOMAINS=

# Require confirmation before sensitive actions: always | never | sensitive
# AGENT_BROWSER_CONFIRM_ACTIONS=sensitive

# Path to a custom action policy JSON file
# AGENT_BROWSER_ACTION_POLICY=

# ── Streaming ─────────────────────────────────────────────────────────────────

# Port for the browser stream server (screenshot/video streaming)
# AGENT_BROWSER_STREAM_PORT=3001

# ── iOS Simulator ─────────────────────────────────────────────────────────────

# iOS simulator device name (e.g., "iPhone 15")
# AGENT_BROWSER_IOS_DEVICE=

# iOS simulator UDID (overrides AGENT_BROWSER_IOS_DEVICE)
# AGENT_BROWSER_IOS_UDID=
